# 실제 값은 .env(로컬)와 Vercel 환경 변수에만 넣는다. FE에는 넣지 않는다
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Gemini는 결제가 연결된 프로젝트의 키(무료 등급은 서비스 경로에 쓰지 않는다)
GEMINI_API_KEY=
# 작업 모델(사람들이 실제로 쓰는 수준). 비우면 claude-sonnet-5-5 / gpt-6.1-sol / gemini-3.8-flash
WORKER_ANTHROPIC=
WORKER_OPENAI=
WORKER_GOOGLE=
# 감사 모델(회사마다 하나). 비우면 claude-opus-5-5 / gpt-6.1-sol / gemini-4-argon
AUDITOR_ANTHROPIC=
AUDITOR_OPENAI=
AUDITOR_GOOGLE=
# 회사별 하루 금액 상한(달러, 한국 시각 날짜별, KV에서 셈)과 전체 하루 호출 상한
CAP_USD_ANTHROPIC=10
CAP_USD_OPENAI=6
CAP_USD_GOOGLE=6
LLM_DAILY_CALL_CAP=400
# 팀장 모드(라이브) 하루 횟수: 기기당, 만든 사람 기기당, 전체
LEAD_PER_DEVICE=2
LEAD_PER_MAKER=15
LEAD_PER_DAY=30
# 만든 사람 검수 화면 코드(머리글 x-review-code). 비우면 검수 기능이 닫힌다
REVIEW_CODE=
# FE 배포 주소(CORS), 비우면 전체 허용
ALLOWED_ORIGIN=
# 기록 저장소(Vercel에 Upstash Redis를 연결하면 자동으로 들어옴). 비우면 서버 메모리
KV_REST_API_URL=
KV_REST_API_TOKEN=
