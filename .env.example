# 실제 값은 .env에만 넣는다
ANTHROPIC_API_KEY=
DATA_GO_KR_KEY=
HRFCO_KEY=
SAFETYDATA_KEY=
# 하루 LLM 호출 상한
LLM_DAILY_CALL_CAP=2000
# 모델(비우면 기본값)
MODEL_LIGHT=claude-haiku-5-5
MODEL_MAIN=claude-sonnet-5-5
# FE 배포 주소(CORS), 비우면 전체 허용
ALLOWED_ORIGIN=
# 시연 코드(선택). 넣으면 화면에서 이 코드를 입력해야 AI가 돈다
DEMO_ACCESS_CODE=
# 체험 계정 기간(YYYY-MM-DD, 한국 시각 그날 끝까지 코드 없이 사용)
OPEN_ACCESS_UNTIL=
# 당직실 인계함(Vercel에 Upstash Redis를 연결하면 자동으로 들어옴). 비우면 서버 메모리에 두어 재시작하면 사라짐
KV_REST_API_URL=
KV_REST_API_TOKEN=
