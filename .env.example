# 실제 값은 .env에만 넣는다
ANTHROPIC_API_KEY=
# 작성 모델과 점검 모델(반드시 다른 모델). 비우면 claude-opus-5-5 / claude-sonnet-5-5
MODEL_WRITER=
MODEL_CHECKER=
# 점검을 다른 회사 모델로 할 때: CHECKER_PROVIDER=gemini, MODEL_CHECKER=<Gemini 모델 이름>, GEMINI_API_KEY=
CHECKER_PROVIDER=
GEMINI_API_KEY=
# 하루 모델 호출 상한(한국 시각 날짜별, KV에서 셈)
LLM_DAILY_CALL_CAP=300
# FE 배포 주소(CORS), 비우면 전체 허용
ALLOWED_ORIGIN=
# 기록 저장소(Vercel에 Upstash Redis를 연결하면 자동으로 들어옴). 비우면 서버 메모리에 두어 재시작하면 사라짐
KV_REST_API_URL=
KV_REST_API_TOKEN=
